# Copy to .env and replace the password before starting local Docker Compose.
POSTGRES_USER=amafh_v2
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=amafh_v2_dev
TRUSTED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Local HTTP only; set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
